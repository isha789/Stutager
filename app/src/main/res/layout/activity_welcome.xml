<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white_background"
    tools:context=".WelcomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Top Illustration -->
        <ImageView
            android:layout_width="220dp"
            android:layout_height="160dp"
            android:src="@drawable/img_welcome_illustration"
            android:contentDescription="Calendar Illustration"
            android:layout_marginTop="32dp"/>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue"
            android:layout_marginTop="16dp"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_tagline"
            android:textSize="14sp"
            android:textColor="@color/text_gray"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="40dp"/>

        <!-- Primary Button: Inicia sessió -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIniciaSessio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:drawableStart="@drawable/ic_user"
            android:drawableTint="@color/white_background"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_pill_blue"
            android:layout_marginBottom="16dp"/>

        <!-- Secondary Button: Registra't -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegistrat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_register"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:drawableStart="@drawable/ic_user_add"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_pill_outline"
            android:layout_marginBottom="20dp"/>

        <!-- Text Button: Continua com a convidat -->
        <LinearLayout
            android:id="@+id/btnConvidat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_dark"
                android:contentDescription="Eye icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_guest"
                android:textSize="15sp"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Footer Illustration & Text -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="32dp"
            android:src="@drawable/img_welcome_footer"
            android:contentDescription="Footer hills line"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_footer"
            android:textSize="13sp"
            android:textColor="@color/text_gray"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
