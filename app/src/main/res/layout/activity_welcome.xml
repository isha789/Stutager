<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".WelcomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="440dp">

            <!-- Top Illustration -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="160dp"
                android:layout_marginTop="32dp"
                android:contentDescription="Calendar Illustration"
                android:src="@drawable/img_welcome_illustration" />

            <!-- App Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/dark_blue"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="40dp"
                android:text="@string/welcome_tagline"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Primary Button: Inicia sessió -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIniciaSessio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pill_blue"
                android:clickable="true"
                android:drawableStart="@drawable/ic_user"
                android:drawableTint="@color/white_background"
                android:focusable="true"
                android:maxWidth="360dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAllCaps="false"
                android:text="@string/btn_login"
                android:textColor="@color/white_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Secondary Button: Registra't -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegistrat"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_pill_outline"
                android:clickable="true"
                android:drawableStart="@drawable/ic_user_add"
                android:focusable="true"
                android:maxWidth="360dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAllCaps="false"
                android:text="@string/btn_register"
                android:textColor="@color/dark_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Text Button: Continua com a convidat -->
            <LinearLayout
                android:id="@+id/btnConvidat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Eye icon"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_guest"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Footer Illustration & Text -->
            <ImageView
                android:layout_width="160dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Footer hills line"
                android:src="@drawable/img_welcome_footer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/welcome_footer"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
