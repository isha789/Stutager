<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white_background"
    tools:context=".InitialHelpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- App Logo Header -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_checklist"
            app:tint="@color/primary_blue"
            android:contentDescription="@string/app_name"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/dark_blue"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_gray"
            android:textAlignment="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"/>

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="26dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="1"
                android:textColor="@color/white_background"
                android:background="@drawable/bg_pill_blue"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_add_document"
                app:tint="@color/dark_blue"
                android:contentDescription="@string/step1_title"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step1_title"
                    android:textColor="@color/dark_blue"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step1_desc"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="26dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="2"
                android:textColor="@color/white_background"
                android:background="@drawable/bg_pill_blue"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_list"
                app:tint="@color/dark_blue"
                android:contentDescription="@string/step2_title"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_title"
                    android:textColor="@color/dark_blue"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_desc"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="36dp"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="3"
                android:textColor="@color/white_background"
                android:background="@drawable/bg_pill_blue"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/dark_blue"
                android:contentDescription="@string/step3_title"
                android:layout_marginStart="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step3_title"
                    android:textColor="@color/dark_blue"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step3_desc"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Start Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComenca"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_start"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            android:textAllCaps="false"
            android:background="@drawable/bg_pill_blue"/>

        <!-- Page Indicators -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="16sp"
                android:textColor="@color/primary_blue"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textSize="16sp"
                android:textColor="@color/text_light_gray"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textSize="16sp"
                android:textColor="@color/text_light_gray"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
