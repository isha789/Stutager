<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stutager">

        <!-- Page 1: Initial Help / Onboarding (Launcher Activity) -->
        <activity
            android:name=".InitialHelpActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Page 2: Welcome -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Page 3: Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Page 4: Activities Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Other Screens -->
        <activity android:name=".ActivitiesActivity" android:exported="false" />
        <activity android:name=".AllTasksActivity" android:exported="false" />
        <activity android:name=".TaskDetailActivity" android:exported="false" />
        <activity android:name=".TaskEditActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />

    </application>

</manifest>
